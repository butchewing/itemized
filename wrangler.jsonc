// Portable configuration, used by the Deploy to Cloudflare button and `npm run deploy`.
// No account, domain or resource IDs: Wrangler creates the D1 database, R2 bucket and queue in the
// deploying account. itemized.mortuary.ai deploys from wrangler.production.jsonc instead.
// Every name differs from production, so an accidental `npm run deploy` here creates a separate app rather than replacing it.
{
  "name": "itemized-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  // Fictional sample lists served as static files at /samples/*
  "assets": { "directory": "./public" },
  "d1_databases": [{ "binding": "DB", "database_name": "itemized-app", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "itemized-app-docs" }],
  "queues": {
    "producers": [{ "binding": "AUDITS", "queue": "itemized-app-audits" }],
    "consumers": [{ "queue": "itemized-app-audits", "max_batch_size": 1, "max_retries": 3 }]
  },
  // remote: wrangler dev renders on Cloudflare's Browser Run instead of downloading a local Chromium.
  "browser": { "binding": "BROWSER", "remote": true },
  // namespace_id is any integer unique among rate limiters in the deploying account.
  "ratelimits": [{ "name": "UPLOAD_LIMITER", "namespace_id": "4531", "simple": { "limit": 5, "period": 60 } }],
  // Daily cleanup of audits, cached results and stored files unused for 30 days.
  "triggers": { "crons": ["17 7 * * *"] },
  "vars": { "MODEL_PROVIDER": "meta-api", "DAILY_BUDGET_USD": "5" },
  // Names only. BASETEN_API_KEY is optional (open-weights provider only), so it is not required here.
  "secrets": { "required": ["META_API_KEY"] }
}
